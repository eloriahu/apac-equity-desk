      "forbidden_workflows": [
        "idea-funnel",
        "parallel-desk"
      ],
      "expected_behaviors": [
        "Use supplied moves with unknown-timestamp limitation; do not request manual re-entry.",
        "Research outside news and verify the earlier backdrop independently of the supplied headline.",
        "Distinguish developer competition from hardware funding, orders and valuation exposures.",
        "First verify facts against inputs and sources, then challenge the explanation against alternatives and counterevidence; recheck affected claims after revisions.",
        "Retain an evidence-supported indirect linkage at proportionate weight without making it the dominant driver.",
        "Test the possible positive compute-demand channel; retain unresolved supplier-specific causes."
      ],
      "forbidden_behaviors": [
        "Treat the launch as the cause of earlier hardware weakness or assert selling spread between groups without chronology.",
        "Imply the same causal link in the lead or transition and attempt to repair it with a later caveat.",
        "Generalize the supplied names to an entire sector without additional market evidence.",
        "Conclude that there is no linkage merely because a dominant causal role is unproven.",
        "Count the same citation twice or a helper pass as completion of both substantive checks.",
        "Treat use-the-screen as a prohibition on outside news or fabricate a live quote time."
      ]
    },
